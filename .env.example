# OpenRouter is OpenAI-compatible. Model ids keep the provider prefix.
LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-6-luna

# Optional. Traces run locally either way; setting this sends them to a hosted
# Logfire project too, with no other code change.
LOGFIRE_TOKEN=

# Optional. Where the local JSONL run log is written. Default: logs/runs.jsonl
PEER_LOG_PATH=
